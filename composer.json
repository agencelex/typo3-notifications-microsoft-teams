{
    "name": "agencelex/notifications-microsoft-teams",
    "description": "A Microsoft Teams notification channel provider for the Laravel-style notification system (agencelex/notifications). Enables sending real-time alerts, structured data, and rich adaptive cards directly to Microsoft Teams channels from any notifiable object.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "notifications",
        "notification system",
        "microsoft teams"
    ],
    "homepage": "https://github.com/agencelex/typo3-notifications-microsoft-teams",
    "authors": [
        {
            "name": "Agence Lex",
            "role": "Agency",
            "homepage": "https://www.agencelex.com/"
        }
    ],
    "support": {
        "issues": "https://github.com/agencelex/typo3-notifications-microsoft-teams/issues"
    },
    "repositories": {
        "local-extensions": {
            "type": "path",
            "url": "Tests/Packages/*"
        },
        "composer": {
            "type": "composer",
            "url": "https://composer.typo3.org/"
        }
    },
    "require": {
        "php": "^8.2",
        "agencelex/notifications": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Lex\\Notifications\\MicrosoftTeams\\": "Classes/"
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "php-http/discovery": true,
            "tbachert/spi": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "require-dev": {
        "b13/make": "^0.9 || ^1.0",
        "typo3/coding-standards": "^0.8",
        "typo3/testing-framework": "^8.0",
        "phpunit/phpunit": "^11.0",
        "saschaegerer/phpstan-typo3": "^1.0",
        "phpstan/extension-installer": "^1.4",
        "symfony/var-dumper": "^7.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Lex\\Notifications\\MicrosoftTeams\\Tests\\": "Tests"
        }
    },
    "extra": {
        "typo3/cms": {
            "web-dir": ".Build/public",
            "extension-key": "notifications_microsoft_teams"

        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cgl": [
            "php-cs-fixer --diff -v fix"
        ],
        "cgl:ci": [
            "php-cs-fixer --diff -v --dry-run fix"
        ],
        "phpstan": [
            "phpstan analyze --configuration Build/phpstan.neon"
        ],
        "phpstan:baseline": [
            "phpstan analyze --configuration Build/phpstan.neon --generate-baseline Build/phpstan-baseline.neon"
        ],
        "test": [
            "@test:php:lint",
            "@test:php:unit",
            "@test:php:functional"
        ],
        "test:php:functional": [
            "phpunit -c Build/phpunit-functional.xml"
        ],
        "test:php:lint": [
            "phplint"
        ],
        "test:php:unit": [
            "phpunit -c Build/phpunit-unit.xml"
        ]
    }
}
